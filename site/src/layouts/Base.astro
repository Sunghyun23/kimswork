---
import '../styles/global.css';
import { url, repo } from '../data/plugins';
interface Props { title: string; description?: string }
const { title, description = 'kim — MPC를 위한 독립 악기와 이펙트. 손끝에서 시작되는 따뜻한 사운드.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#efe9dc"/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><title>{title}</title></head>
<body><a class="skip" href="#content">본문으로 이동</a><header class="nav wrap"><a class="brand" href={url()} aria-label="kim 홈">kim<span>INSTRUMENTS & EFFECTS</span></a><nav aria-label="주 메뉴"><a href={url('#collection')}>플러그인</a><a href={url('install/')}>설치 가이드</a><a href={repo}>GitHub ↗</a></nav></header><main id="content"><slot/></main><footer class="wrap footer"><a class="brand" href={url()}>kim.</a><p>Small instruments. Long afternoons.<br/><span>MPC를 위한 독립 악기와 이펙트.</span></p><a href={repo}>소스 & 개발 기록 ↗</a></footer></body></html>
