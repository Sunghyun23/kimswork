---
import '../styles/global.css';
import { url, repo } from '../data/plugins';
interface Props { title: string; description?: string }
const { title, description = 'kim — Independent instruments and effects for MPC. Warm sounds, close at hand.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en" style="background:#171614;color-scheme:dark"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#171614"/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><title>{title}</title></head>
<body style="background:#171614;color:#eee5d5"><a class="skip" href="#content">Skip to content</a><header class="nav wrap"><a class="brand" href={url()} aria-label="kim home">kim<span>INSTRUMENTS & EFFECTS</span></a><nav aria-label="Main navigation"><a href={url('#collection')}>Plugins</a><a href={url('install/')}>Installation</a><a href={repo}>GitHub ↗</a></nav></header><main id="content"><slot/></main><footer class="wrap footer"><a class="brand" href={url()}>kim.</a><p>Small instruments. Long afternoons.<br/><span>Independent instruments and effects for MPC.</span></p><a href={repo}>Source & development ↗</a></footer></body></html>
