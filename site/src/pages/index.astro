---
import Base from '../layouts/Base.astro';
import {plugins, url} from '../data/plugins';

---
<Base title="kim — Instruments with a little soul."><section class="hero wrap"><div class="eyebrow">INDEPENDENT SOUNDS / MADE FOR MPC</div><h1>Instruments with<br/>a little <em>soul.</em></h1><div class="hero-bottom"><p>Sounds to spend time with.<br/>Small instruments for your MPC.</p><a class="round-link" href="#collection">Explore the collection <span>↘</span></a></div><div class="edition">VOL. 001<br/>THE FIRST PRESSING</div></section>
<section class="collection wrap" id="collection"><div class="section-head"><h2>The collection<span>Sounds in the making</span></h2><span class="eyebrow">{String(plugins.length).padStart(2,'0')} / INSTRUMENTS</span></div>{plugins.map((p,i)=><article class="product"><a class="cover" href={url(`plugins/${p.slug}/`)} aria-label={`Explore ${p.name}`}><div class="cover-top"><span>KIM RECORDING INSTRUMENTS</span><span>NO. {String(i+1).padStart(3,'0')}</span></div><img src={url(`images/${p.image}`)} alt={p.imageAlt} width="1536" height="961"/><div class="cover-bottom"><span>DESIGN STUDY / CONCEPT ART</span><span>33⅓ RPM OF INSPIRATION</span></div></a><div class="product-copy"><span class="badge">{p.release ? `Available version · ${p.release.version}` : 'Development alpha · In testing'}</span><p class="eyebrow">{p.category}</p><h3>{p.name}</h3><h4>{p.tagline}</h4><p>{p.description}</p><a class="button" href={url(`plugins/${p.slug}/`)}>Explore the instrument <span>↗</span></a><small>{p.release ? `Available version ${p.release.version}` : `Not yet available · Development build ${p.developmentVersion}`}</small></div></article>)}</section>
<section class="note wrap"><span class="eyebrow">THE WAY WE MAKE THINGS</span><h2>Closer to the music.<br/>Closer to the idea.</h2><p>Spend less time in menus and more time shaping sounds. We are building thoughtful instruments, one at a time, to keep your next idea within reach.</p></section></Base>
