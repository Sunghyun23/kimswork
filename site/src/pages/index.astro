---
import Base from '../layouts/Base.astro';
import {plugins, url} from '../data/plugins';
const featured = plugins[0];
---
<Base title="Kim’s Work — Instrument plugins for MPC standalone" description="Independent MPC instruments, desktop tools and sound packs. Explore the Kim’s Work software collection.">
  <section class="launch wrap">
    <div class="launch-copy">
      <div class="eyebrow">KIM’S WORK / INDEPENDENT INSTRUMENTS</div>
      <h1>Music software.<br/><em>Made for your session.</em></h1>
      <p class="launch-intro">Vintage-inspired sounds, designed for hands-on music making.</p>
      <div class="featured-summary">
        <span class="eyebrow">MEET OUR FIRST INSTRUMENT</span>
        <h2>{featured.name}</h2>
        <p>{featured.summary}</p>
        <p class="release-status">{featured.release ? `Available now · v${featured.release.version}` : 'In development — not available to download yet.'}</p>
        <a class="button" href={url(`plugins/${featured.slug}/`)}>Explore {featured.name} <span aria-hidden="true">→</span></a>
        <p class="platform-note">For MPC standalone · OS 3.10.1 or later</p>
      </div>
    </div>
    <figure class="launch-art">
      <a class="cover" href={url(`plugins/${featured.slug}/`)} aria-label={`Explore ${featured.name}`}>
        <div class="cover-top"><span>KIM’S WORK INSTRUMENTS</span><span>NO. 001</span></div>
        <img src={url(`images/${featured.image}`)} alt={featured.imageAlt} width="1280" height="800" fetchpriority="high"/>
        <div class="cover-bottom"><span>{featured.name.toUpperCase()}</span><span>MPC SCREENSHOT</span></div>
      </a>
      <figcaption>Actual MPC Live III screen capture.</figcaption>
      <p class="art-note">A little soul. A lot of possibility.</p>
    </figure>
  </section>
  <section class="catalog wrap" id="collection">
    <div class="section-head"><h2>Our plugins<span>What we are building, and what is available.</span></h2><span class="eyebrow">{String(plugins.length).padStart(2,'0')} / INSTRUMENTS</span></div>
    {plugins.map(p=><article class="catalog-row"><div><p class="eyebrow">{p.category}</p><h3>{p.name}</h3><p>{p.summary}</p></div><div class="catalog-action"><p class="release-status">{p.release ? `Available · v${p.release.version}` : 'In development · No public download'}</p><a href={url(`plugins/${p.slug}/`)}>View features & status →</a></div></article>)}
  </section>
  <section class="note wrap"><span class="eyebrow">MADE FOR MAKING MUSIC</span><h2>Less menu diving.<br/>More music making.</h2><p>We make independent instruments for your MPC standalone workflow. Explore each plugin for its features, tested devices, and release status. Installation instructions are available when you are ready for a published release.</p></section>
<section class="wrap guide"><p class="eyebrow">EXPLORE THE COLLECTION</p><h2>Find your next tool.</h2><div class="software-grid"><a class="software-card" href={url('software/instruments/')}><h3>Instruments →</h3><p>Donut Theory and Groove Dice for MPC standalone.</p></a><a class="software-card" href={url('software/apps/')}><h3>Apps →</h3><p>Build and manage your own sound expansions.</p></a><a class="software-card" href={url('software/expansions/')}><h3>Expansions →</h3><p>Independent packs, organized by target instrument.</p></a></div></section></Base>
