---
import Base from '../layouts/Base.astro';
import {plugins, url} from '../data/plugins';
import {loopClub} from '../data/loop-club';
const featured = plugins.find(p=>p.slug==='donut-theory')!;
const otherPlugins = plugins.filter(p=>p.slug!==featured.slug);
---
<Base title="Kim’s Work — Music software for MPC standalone" description="Independent MPC instruments, desktop tools and sound packs. Explore the Kim’s Work software collection.">
  <section class="launch wrap">
    <div class="launch-copy">
      <div class="eyebrow">KIM’S WORK / MUSIC SOFTWARE</div>
      <h1>Music software.<br/><em>Made for your session.</em></h1>
      <p class="launch-intro">Vintage-inspired sounds, designed for hands-on music making.</p>
      <div class="featured-summary">
        <span class="eyebrow">MEET OUR FIRST INSTRUMENT</span>
        <h2>{featured.name}</h2>
        <p>{featured.summary}</p>
        <p class="release-status">{featured.release ? `Available now · v${featured.release.version}` : 'In development — not available to download yet.'}</p>
        <a class="button" href={url(`plugins/${featured.slug}/`)}>Explore {featured.name} <span aria-hidden="true">→</span></a>
        <p class="platform-note">For MPC standalone · OS 3.10.1 or later</p>
      </div>
    </div>
    <figure class="launch-art">
      <a class="cover" href={url(`plugins/${featured.slug}/`)} aria-label={`Explore ${featured.name}`}>
        <div class="cover-top"><span>KIM’S WORK INSTRUMENTS</span><span>NO. 001</span></div>
        <img src={url(`images/${featured.image}`)} alt={featured.imageAlt} width="1280" height="800" fetchpriority="high"/>
        <div class="cover-bottom"><span>{featured.name.toUpperCase()}</span><span>MPC SCREENSHOT</span></div>
      </a>
      <figcaption>Actual MPC XL screen capture.</figcaption>
      <p class="art-note">A little soul. A lot of possibility.</p>
    </figure>
  </section>
  <section class="catalog wrap"><div class="section-head"><h2>Now for MPC Sample.</h2></div><article class="catalog-row"><a class="catalog-thumbnail" href={url('mods/loop-club/')}><img src={url(`images/${loopClub.image}`)} width="320" height="240" loading="lazy" alt="Loop Club actual MPC Sample loop overview"/></a><div><p class="eyebrow">MPC SAMPLE · PUBLIC PREVIEW</p><h3>Loop Club</h3><p>Sixteen independent audio, synth and drum loops. Layer your sounds, shape the groove and keep playing.</p></div><div class="catalog-action"><p class="release-status">Preview {loopClub.version} · Firmware1.3.0.12</p><a href={url('mods/loop-club/')}>Explore Loop Club →</a></div></article></section>
  <section class="catalog wrap" id="collection">
    <div class="section-head catalog-heading"><h2>More for your session<span>Explore our other instruments and effects.</span></h2><a href={url('software/')}>All software →</a></div>
    {otherPlugins.map(p=><article class="catalog-row"><a class="catalog-thumbnail" href={url(`plugins/${p.slug}/`)}><img src={url(`images/${p.image}`)} alt={p.imageAlt} width="1280" height="800" loading="lazy"/></a><div><p class="eyebrow">{p.category}</p><h3>{p.name}</h3><p>{p.summary}</p></div><div class="catalog-action"><p class="release-status">{p.release ? `${p.release.preview?'Public preview':'Available'} · v${p.release.version}` : 'In development · No public download'}</p><a href={url(`plugins/${p.slug}/`)}>View features & status →</a></div></article>)}
  </section>
  <section class="note wrap"><span class="eyebrow">MADE FOR MAKING MUSIC</span><h2>Less menu diving.<br/>More music making.</h2><p>We make instruments and effects for your MPC standalone workflow. Explore each plugin for its features, tested devices, and release status. Installation instructions are available when you are ready for a published release.</p></section>
<section class="wrap guide"><p class="eyebrow">EXPLORE THE COLLECTION</p><h2>Find your next tool.</h2><div class="software-grid"><a class="software-card" href={url('software/instruments/')}><h3>Instruments →</h3><p>Synths, physical keys and drums for MPC standalone.</p></a><a class="software-card" href={url('software/effects/')}><h3>Effects →</h3><p>Compression, color and playable performance effects.</p></a><a class="software-card" href={url('software/apps/')}><h3>Apps →</h3><p>Build and manage your own sound expansions.</p></a><a class="software-card" href={url('software/expansions/')}><h3>Expansions →</h3><p>Independent packs, organized by target instrument.</p></a></div></section><section class="wrap guide"><p class="eyebrow">FROM THE WORKSHOP</p><h2>See how a sound begins.</h2><div class="product"><a href={url('learn/physical-modeling/')}><img src={url('images/physical-modeling/flow.svg')} width="640" height="320" loading="lazy" alt="Touch becomes vibration, then sound: an illustrated physical-modeling guide."/></a><div><h3>Inside Felt Club</h3><p>Why does a reed bite while a tine rings? Explore seven developing instrument engines through 14 original diagrams and short audio examples. A beginner-friendly look inside physical modeling.</p><a href={url('learn/physical-modeling/')}>Read the illustrated guide →</a><p class="release-status">Development journal · Not a plugin release</p></div></div></section></Base>
