---
import Base from '../../layouts/Base.astro';
import {plugins,url,repo,releaseLinks} from '../../data/plugins';
export function getStaticPaths(){ return plugins.map(plugin=>({params:{slug:plugin.slug},props:{plugin}})); }
const {plugin:p}=Astro.props;const release=releaseLinks(p);
---
<Base title={`${p.name} — kim`} description={p.description}><section class="detail-head wrap"><a class="back" href={url('#collection')}>← 컬렉션</a><div class="eyebrow">{p.category} / KIM</div><h1>{p.name}</h1><p class="lead">{p.tagline}</p><span class="badge">{p.release ? `공개 버전 · ${p.release.version}` : `개발 알파 · ${p.developmentVersion}`}</span></section><figure class="detail-image wrap"><img src={url(`images/${p.image}`)} alt={p.imageAlt} width="1536" height="961"/><figcaption>승인된 디자인 시안입니다. 실제 MPC 실행 화면과 세부 배치가 다를 수 있습니다.</figcaption></figure>
<section class="wrap intro"><div><span class="eyebrow">A WARM START</span><h2>당신의 다음 루프에,<br/>조금의 온기를.</h2></div><p>{p.description} {p.intro}</p></section><section class="wrap features" aria-label="기능 소개">{p.features.map((f,i)=><article><span class="eyebrow">0{i+1}</span><h3>{f.title}</h3><p>{f.text}</p></article>)}</section>
<section class="wrap mapping"><span class="eyebrow">DESIGNED FOR YOUR HANDS</span><h2>네 그룹, 열여섯 개의 조절.</h2><p>전면 Q-Link의 설계 기준입니다. 실제 검증 상태는 아래 호환성과 현재 제한을 참고하세요.</p><div class="table-scroll"><table><thead><tr><th>그룹</th><th>1</th><th>2</th><th>3</th><th>4</th></tr></thead><tbody>{p.mapping.map(row=><tr><th>{row[0]}</th>{row.slice(1).map(value=><td>{value}</td>)}</tr>)}</tbody></table></div></section>
<section class="wrap availability" id="download"><div><span class="eyebrow">AVAILABILITY</span><h2>{release?'플레이할 준비.':'아직, 다듬고 있습니다.'}</h2><p>현재 개발 버전 {p.developmentVersion}. 공개 배포와 개발 진행 상태를 구분해 안내합니다.</p>{release?<div class="actions"><a class="button" href={release.asset}>v{p.release?.version} 다운로드 ↓</a><a href={release.page}>릴리스 노트 ↗</a></div>:<><span class="badge">공개 다운로드 준비 중</span><p><a href={repo}>GitHub에서 개발 현황 보기 ↗</a></p></>}<a href={url('install/')}>설치 방법 알아보기 →</a></div><aside><h3>호환성과 현재 제한</h3><ul><li>MPC standalone · OS 3.10.1 이상</li><li>Enable Enhancements / External Plugin Support 필요</li><li>확인 기기: {p.verifiedDevice}</li>{p.limitations.map(item=><li>{item}</li>)}</ul><p>native·ARM32·ARM64 빌드와 자동 테스트 통과가 실기기 검증 완료를 뜻하지는 않습니다.</p></aside></section></Base>
