---
import Base from '../../layouts/Base.astro';
import {plugins,url,repo,releaseLinks} from '../../data/plugins';
export function getStaticPaths(){ return plugins.map(plugin=>({params:{slug:plugin.slug},props:{plugin}})); }
const {plugin:p}=Astro.props;const release=releaseLinks(p);
---
<Base title={`${p.name} — Synthesizer for MPC standalone | kim`} description={p.description}>
<section class="detail-head wrap product-overview">
  <a class="back" href={url('#collection')}>← All plugins</a>
  <div class="eyebrow">{p.category} / MPC STANDALONE</div>
  <h1>{p.name}</h1>
  <p class="lead">{p.summary}</p>
  <p class="release-status">{release ? `Available now · v${p.release?.version}` : 'In development — not available to download yet.'}</p>
  <p class="platform-note">Requires MPC standalone OS 3.10.1 or later and External Plugin Support.</p>
  <div class="overview-actions"><a class="button" href="#features">Explore the features ↓</a><a href="#download">{release ? 'Download & compatibility →' : 'Development status & compatibility →'}</a></div>
</section><figure class="detail-image wrap"><img src={url(`images/${p.image}`)} alt={p.imageAlt} width="1536" height="961"/><figcaption>Approved design concept. The running MPC interface and detailed layout may differ.</figcaption></figure>
<section class="wrap intro"><div><span class="eyebrow">A WARM START</span><h2>A little warmth<br/>for your next loop.</h2></div><p>{p.description} {p.intro}</p></section><section class="wrap features" id="features" aria-label="Features">{p.features.map((f,i)=><article><span class="eyebrow">0{i+1}</span><h3>{f.title}</h3><p>{f.text}</p></article>)}</section>
<section class="wrap availability" id="download"><div><span class="eyebrow">AVAILABILITY</span><h2>{release?'Download & compatibility':'Development status'}</h2><p>Current development build: {p.developmentVersion}. Public releases are listed separately from work in progress.</p>{release?<div class="actions"><a class="button" href={release.asset}>v{p.release?.version} Download ↓</a><a href={release.page}>Release notes ↗</a></div>:<><span class="badge">Not available to download yet</span><p><a href={repo}>Follow development on GitHub ↗</a></p></>}<a href={url('install/')}>Read the installation guide →</a></div><aside><h3>Compatibility & known limitations</h3><ul><li>MPC standalone · OS 3.10.1 or later</li><li>Enable Enhancements and External Plugin Support required</li><li>Device used for testing: {p.verifiedDevice}</li>{p.limitations.map(item=><li>{item}</li>)}</ul><p>Native, ARM32, and ARM64 builds and automated tests pass. Hardware validation is not yet complete.</p></aside></section>
<section class="wrap mapping"><span class="eyebrow">DESIGNED FOR YOUR HANDS</span><h2>Four banks. Sixteen controls.</h2><p>The intended front-panel Q-Link layout. See the development status and known limitations above for the current validation status.</p><div class="table-scroll"><table><thead><tr><th>Bank</th><th>1</th><th>2</th><th>3</th><th>4</th></tr></thead><tbody>{p.mapping.map(row=><tr><th>{row[0]}</th>{row.slice(1).map(value=><td>{value}</td>)}</tr>)}</tbody></table></div></section>
</Base>
