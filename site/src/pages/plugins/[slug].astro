---
import Base from '../../layouts/Base.astro';
import {plugins,url,repo,releaseLinks} from '../../data/plugins';
export function getStaticPaths(){ return plugins.map(plugin=>({params:{slug:plugin.slug},props:{plugin}})); }
const {plugin:p}=Astro.props;const release=releaseLinks(p);
---
<Base title={`${p.name} — Synthesizer for MPC standalone | Kim’s Work`} description={p.description}>
<section class="detail-head wrap product-overview">
  <a class="back" href={url('#collection')}>← All plugins</a>
  <div class="eyebrow">{p.category} / MPC STANDALONE</div>
  <h1>{p.name}</h1>
  <p class="lead">{p.summary}</p>
  <p class="release-status">{release ? `Available now · v${p.release?.version}` : 'In development — not available to download yet.'}</p>
  <p class="platform-note">Requires MPC standalone OS 3.10.1 or later and External Plugin Support.</p>
  <div class="overview-actions"><a class="button" href={release ? "#download" : "#features"}>{release ? `Download v${p.release?.version} ↓` : "Explore the features ↓"}</a>{p.manual && <a href={url(p.manual)}>User manual →</a>}<a href="#whats-new">What’s new →</a><a href="#download">{release ? 'Download & compatibility →' : 'Development status & compatibility →'}</a></div>
</section><figure class="detail-image wrap"><img src={url(`images/${p.image}`)} alt={p.imageAlt} width="1280" height="800"/><figcaption>Actual Donut Theory 1.2.1 running on MPC Live III / OS 3.10.1.12.</figcaption></figure>
<section class="wrap intro"><div><span class="eyebrow">A WARM START</span><h2>A little warmth<br/>for your next loop.</h2></div><p>{p.description} {p.intro}</p></section><section class="wrap features" id="features" aria-label="Features">{p.features.map((f,i)=><article><span class="eyebrow">0{i+1}</span><h3>{f.title}</h3><p>{f.text}</p></article>)}</section>
<section class="wrap release-changes" id="whats-new"><span class="eyebrow">WHAT’S NEW · VERSION {p.release?.version ?? p.developmentVersion}</span><h2>A new analog heart.<br/>The same hands-on instrument.</h2><div class="features">{p.changes.map(change=><article><h3>{change.title}</h3><p>{change.text}</p></article>)}</div>{release && <p><a href={release.page}>Full release notes and verification →</a></p>}</section>
<section class="wrap engine-demo"><span class="eyebrow">HEAR THE ENGINE CHANGE</span><h2>Same settings. Different engine.</h2><p>Three comparisons: bass, resonant lead and a four-note chord. Each plays 1.1.2 first, then 1.2.0, using identical saved settings and MIDI with effects off. A common +9.54 dB gain is applied to the whole demo; the pairs are not individually normalized. This is a native offline render, not a recording from the MPC.</p><audio controls preload="none" style="width:100%;max-width:640px" aria-label="Donut Theory old and new engine comparison"><source src={url('audio/donut-theory-engine-1.1.2-vs-1.2.0.wav')} type="audio/wav"/><a href={url('audio/donut-theory-engine-1.1.2-vs-1.2.0.wav')}>Download the comparison WAV</a></audio></section>
<section class="wrap availability" id="download"><div><span class="eyebrow">AVAILABILITY</span><h2>{release?'Download & compatibility':'Development status'}</h2><p>Current version: {p.developmentVersion}. Download the complete MPC package and read the release notes before upgrading.</p>{release?<div class="actions"><a class="button" href={release.asset}>v{p.release?.version} Download ↓</a><a href={release.page}>Release notes ↗</a></div>:<><span class="badge">Not available to download yet</span><p><a href={repo}>Follow development on GitHub ↗</a></p></>}<a href={url('install/')}>Read the installation guide →</a>{p.manual && <p><a href={url(p.manual)}>Read the complete user manual →</a></p>}</div><aside><h3>Compatibility & known limitations</h3><ul><li>MPC standalone · OS 3.10.1 or later</li><li>Enable Enhancements and External Plugin Support required</li><li>Device used for testing: {p.verifiedDevice}</li>{p.limitations.map(item=><li>{item}</li>)}</ul><p>Native, ARM32 and ARM64 builds, SDK validation and automated audio/state tests pass. Device-specific verification and remaining limits are described in the manual.</p></aside></section>
<section class="wrap screenshot-gallery" aria-label="Actual MPC screens"><div class="section-head"><h2>On your MPC<span>Real screens from the running instrument.</span></h2></div><div class="screen-grid">{p.screenshots.slice(1).map(screen=><figure><a href={url(`images/${screen.image}`)}><img src={url(`images/${screen.image}`)} alt={screen.alt} width="1280" height="800" loading="lazy"/></a><figcaption>{screen.caption}</figcaption></figure>)}</div></section>
<section class="wrap mapping"><span class="eyebrow">DESIGNED FOR YOUR HANDS</span><h2>Four banks. Sixteen controls.</h2><p>The MAIN performance mapping. The CHORD editor uses four rows of Root, Type, Voicing and Octave for the selected bank in Screen mode.</p><div class="table-scroll"><table><thead><tr><th>Bank</th><th>1</th><th>2</th><th>3</th><th>4</th></tr></thead><tbody>{p.mapping.map(row=><tr><th>{row[0]}</th>{row.slice(1).map(value=><td>{value}</td>)}</tr>)}</tbody></table></div></section>
</Base>
