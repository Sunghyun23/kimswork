---
import Base from '../../layouts/Base.astro';
import SoftwareCard from '../../components/SoftwareCard.astro';
import {categories,softwareItems} from '../../data/software';
import {url} from '../../data/plugins';
---
<Base title="Software — Kim’s Work" description="Explore MPC instruments, effects, desktop apps and independent sound expansions."><article class="wrap guide"><p class="eyebrow">KIM’S WORK / SOFTWARE</p><h1>Tools for your<br/>next session.</h1><p class="lead">Instruments, effects and sound tools. See the software, find your workflow.</p><nav class="category-tabs" aria-label="Software categories">{categories.map(c=><a href={url(`software/${c.slug}/`)}>{c.name}</a>)}</nav><div class="software-grid">{softwareItems.map(item=><SoftwareCard item={item}/>)}</div></article></Base>
