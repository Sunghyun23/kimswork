---
import Base from '../../layouts/Base.astro';
import SoftwareCard from '../../components/SoftwareCard.astro';
import {categories,softwareItems} from '../../data/software';
import {url} from '../../data/plugins';
export function getStaticPaths(){return categories.map(category=>({params:{category:category.slug},props:{category}}));}
const {category:c}=Astro.props;
const items=softwareItems.filter(p=>p.category===c.slug);
---
<Base title={`${c.name} — Kim’s Work`} description={c.description}><article class="wrap guide"><a class="back" href={url('software/')}>← All software</a><p class="eyebrow">KIM’S WORK / {c.name.toUpperCase()}</p><h1>{c.name}</h1><p class="lead">{c.description}</p><nav class="category-tabs" aria-label="Software categories">{categories.map(v=><a aria-current={v.slug===c.slug?'page':undefined} href={url(`software/${v.slug}/`)}>{v.name}</a>)}</nav><div class="software-grid">{items.map(item=><SoftwareCard item={item}/>)}</div></article></Base>
