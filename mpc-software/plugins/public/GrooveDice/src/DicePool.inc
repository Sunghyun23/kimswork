// A bounded selected-kit set uses stable kit identities in saved state.
std::array<std::atomic<int>,64>selectedKits{};
std::array<std::array<std::atomic<char>,128>,64>selectedKitIds{};
static constexpr size_t PoolTrailerSize=8+64*128;
int poolCount()const{int n=0;for(auto&id:selectedKits)n+=id.load()>0;return n;}
int poolAt(int n)const{for(auto&id:selectedKits)if(id.load()>0){if(n--==0)return id.load();}return 0;}
bool poolContains(int id)const{for(auto&i:selectedKits)if(i.load()==id)return true;return false;}
void applyPoolPart(int g,int id){if(id<=0||id>int(library.factoryKits.size()))return;const auto&kit=library.factoryKits[id-1];for(int j=0;j<(g==2?2:g==3?4:1);++j){int role=g==2?2+j:g==3?4+j:g;if(getBool(kRoleLock0+role))continue;layerSet(kXSample0+role,kit.sounds[role]);missingSample[role].store(false);int keys[]={kLevel0,kTune0,kDecay0,kPan0,kChoke0};for(int k=0;k<5;++k)layerSet(keys[k]+role*9,kit.parts[role][k]);}layerSet(kXKit,0);}
void queuePoolUi(){for(int i=kPoolInfo;i<=kPoolRow7;++i)changed[i].store(true);displayPending.store(true);}
template<class Command>void processPoolCommands(Command&command){if(command(kPoolOpen)&&getBool(kPoolOpen)){layerSet(kDicePool,2);queuePoolUi();}if(command(kPoolClear)){for(int j=0;j<64;++j){selectedKits[j].store(0);selectedKitIds[j][0]=0;}queuePoolUi();}for(int row=0;row<8;++row)if(command(kPoolPick0+row)){int pos=getInt(kXKitPage)*8+row;const auto&items=kitItems();if(pos>=int(items.size()))continue;int id=items[pos]+1;bool removed=false;for(int j=0;j<64;++j)if(selectedKits[j].load()==id){selectedKits[j].store(0);selectedKitIds[j][0]=0;removed=true;break;}if(!removed)for(int j=0;j<64;++j)if(selectedKits[j].load()==0&&selectedKitIds[j][0]==0){selectedKits[j].store(id);const auto&name=library.factoryKits[id-1].id;for(int n=0;n<128;++n)selectedKitIds[j][n].store(n<int(name.size())?name[n]:0);break;}queuePoolUi();}}
bool poolFormat(int key,std::string&out){if(key==kPoolInfo){int missing=0;for(int j=0;j<64;++j)missing+=selectedKits[j].load()==0&&selectedKitIds[j][0]!=0;out=std::to_string(poolCount())+" KITS SELECTED"+(missing?" / "+std::to_string(missing)+" MISSING":"");return true;}if(key>=kPoolRow0&&key<=kPoolRow7){int pos=getInt(kXKitPage)*8+key-kPoolRow0;const auto&items=kitItems();out=pos<int(items.size())?std::string(poolContains(items[pos]+1)?"[x] ":"[ ] ")+kitCaption(items[pos]+1):"";return true;}return false;}
void savePoolState(std::vector<uint8_t>&out){const char magic[]="GDPL0001";out.insert(out.end(),magic,magic+8);for(auto&id:selectedKitIds)for(int k=0;k<128;++k)out.push_back(uint8_t(id[k]));}
void loadPoolState(const uint8_t*data,size_t&size){for(int j=0;j<64;++j){selectedKits[j].store(0);for(auto&c:selectedKitIds[j])c.store(0);}if(size<PoolTrailerSize||std::memcmp(data+size-PoolTrailerSize,"GDPL0001",8))return;const uint8_t*ptr=data+size-PoolTrailerSize+8;size-=PoolTrailerSize;for(int j=0;j<64;++j){char name[129]{};for(int n=0;n<128;++n){name[n]=char(ptr[j*128+n]);selectedKitIds[j][n].store(name[n]);}for(size_t k=0;k<library.factoryKits.size();++k)if(library.factoryKits[k].id==name){selectedKits[j].store(int(k)+1);break;}}}

void rollPoolLayers(){for(int role=0;role<2;++role)for(int layer=1;layer<4;++layer){if(!getBool(layerKey(role,layer,LOn))||getBool(layerKey(role,layer,LLock)))continue;int id=0;if(getInt(kDicePool)==2){int count=poolCount();if(count)id=library.factoryKits[poolAt(random()%count)-1].sounds[role];}else if(!layerAll[role].empty())id=layerAll[role][random()%layerAll[role].size()];if(id>0){layerSet(layerKey(role,layer,LSample),id);layerMissing[role*3+layer-1].store(0);}}}
