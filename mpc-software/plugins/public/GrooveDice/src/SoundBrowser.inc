// Fixed-size paged list: selection, arrows and SCREEN Q-Link use one source mapping.
bool soundIsSample(int n)const{return getBool(kSampleBrowserOpen)?n==0:!getBool(kSoundDetails)&&n%4==0&&soundRole(n/4)>=0;}
const std::vector<int>& sampleItems(int row)const{return getBool(kCymbalView)?cymbalItems(row):layerItems(soundRole(row));}
int sampleCount(int row)const{return soundRole(row)<0?0:int(sampleItems(row).size())+(getBool(kCymbalView)?2:1);}
int sampleId(int row,int position)const{int extra=getBool(kCymbalView)?2:1;if(position<extra)return position==1?-1:0;const auto&list=sampleItems(row);return position-extra<int(list.size())?list[position-extra]:0;}
int samplePosition(int row)const{int key=soundKey(row,LSample);if(key<0)return 0;int id=getInt(key);if(id==0)return 0;if(getBool(kCymbalView)&&id==-1)return 1;const auto&items=sampleItems(row);for(size_t j=0;j<items.size();++j)if(items[j]==id)return int(j)+(getBool(kCymbalView)?2:1);return 0;}
void selectSample(int row,int position){int key=soundKey(row,LSample);if(key<0||position<0||position>=sampleCount(row))return;int id=sampleId(row,position);if(getInt(key)==id)return;layerSet(key,id);if(getBool(kCymbalView))cymbalMissing[row].store(0);else{int role=soundRole(row),layer=soundLayer(row);if(layer){layerMissing[role*3+layer-1].store(0);layerSet(layerKey(role,layer,LOn),id?1:0);}else missingSample[role].store(false);layerSet(kXKit,0);}queueLayerUi();}
std::string selectedSampleCaption(int row)const{int key=soundKey(row,LSample);if(key<0)return "--";int id=getInt(key);if(getBool(kCymbalView)){if(cymbalMissing[row].load())return "MISSING SOUND";if(id==0)return "AUTO / CURRENT KIT";if(id<0)return "BUILT-IN";}else if(layerHasMissing(soundRole(row),soundLayer(row)))return "MISSING SOUND";return id>0&&id<=int(library.entries.size())?sampleCaption(id,27):soundLayer(row)>0?"+ ADD SOUND":shortCaption(legacyCaption(soundRole(row)),27);}
bool sampleBrowserFormat(int key,std::string&out){int row=getInt(kSoundRow);if(key==kSampleInfo){out="SAMPLES  "+std::to_string(getInt(kSampleBrowserPage)+1)+" / "+std::to_string(std::max(1,(sampleCount(row)+7)/8));return true;}if(key>=kSampleRow0&&key<=kSampleRow7){int pos=getInt(kSampleBrowserPage)*8+key-kSampleRow0;if(pos>=sampleCount(row)){out="";return true;}int id=sampleId(row,pos);out=(pos==samplePosition(row)?"> ":"  ")+(id>0?sampleCaption(id,27):getBool(kCymbalView)?id==0?std::string("AUTO / CURRENT KIT"):std::string("BUILT-IN"):soundLayer(row)>0?std::string("+ ADD SOUND"):std::string("ORIGINAL SOUND"));return true;}return false;}
void openSampleBrowser(int row){if(soundRole(row)<0)return;layerSet(kSoundRow,row);layerSet(kSampleBrowserPage,samplePosition(row)/8);layerSet(kSampleBrowserOpen,1);syncLayerUi(true);queueLayerUi();}
void queueSamplePreview(int row){if(soundRole(row)<0)return;auditionPending=row;previewContext.store(getBool(kCymbalView)?4:getInt(kSoundPart));previewWait=0;}
std::atomic<int>previewContext{-1};int previewWait=0;
void runSamplePreview(){if(auditionPending<0)return;int row=auditionPending;if(previewContext.load()!=(getBool(kCymbalView)?4:getInt(kSoundPart))){auditionPending=-1;return;}int role=soundRole(row),layer=soundLayer(row),id=getBool(kCymbalView)?cymbalSource(row):getInt(soundKey(row,LSample)),channel=getBool(kCymbalView)?14+row:layer?8+role*3+layer-1:role;
 if(id>0){int cache=library.acquire(channel,id);if(cache<0){if(library.failed[channel].load()==id||++previewWait>1000)auditionPending=-1;return;}library.release(cache);}
 if(getBool(kCymbalView))triggerCymbal(row,110,2000,true);else triggerLayers(role,110,2000,layer,true);auditionPending=-1;
}
static int gridRole(int page,int row){static const int roles[2][4]={{1,5,7,4},{0,2,3,6}};return roles[mpc::clamp(page,0,1)][mpc::clamp(row,0,3)];}
