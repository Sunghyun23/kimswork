+/// Independent callbacks keep input ownership even while UI rendering is busy.
+fn independent_control<T>(
+    handler: Option<fn(T) -> Flow>,
+    event: T,
+    fallback: impl FnOnce() -> Flow,
+) -> Flow {
+    handler.map_or_else(fallback, |handle| handle(event))
+}
