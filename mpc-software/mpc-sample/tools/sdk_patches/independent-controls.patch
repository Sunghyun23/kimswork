+#[cfg(test)]
+mod independent_control_tests {
+    use super::{ButtonEvent, Flow, independent_control};
+    fn consume(_: ButtonEvent) -> Flow {
+        Flow::Consume
+    }
+    fn button() -> ButtonEvent {
+        ButtonEvent {
+            event: 0,
+            bytes: [0; 16],
+            code: 7,
+            value: 127,
+            pressed: true,
+            shift: false,
+            erase: false,
+            surface: 0,
+        }
+    }
+    #[test]
+    fn busy_mod_mutex_cannot_forward_an_independently_owned_button() {
+        let module = std::sync::Mutex::new(());
+        let _busy = module.lock().unwrap();
+        let flow = independent_control(Some(consume as fn(ButtonEvent) -> Flow), button(), || {
+            assert!(module.try_lock().is_err());
+            Flow::Forward
+        });
+        assert_eq!(flow, Flow::Consume);
+    }
+    #[test]
+    fn absent_independent_handler_retains_the_legacy_fallback() {
+        assert_eq!(
+            independent_control(None, button(), || Flow::Forward),
+            Flow::Forward
+        );
+    }
